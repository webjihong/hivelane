{
  "name": "@webjihong/hivelane",
  "version": "0.1.0",
  "private": true,
  "description": "로컬 맥에서 AI 팀(PO·PM·개발·QA)을 여러 개 돌리고 리소스에 맞춰 지휘하는 관제실",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:server": "tsx scripts/bundle-server.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "service:install": "tsx scripts/service.ts install --tailscale",
    "service:uninstall": "tsx scripts/service.ts uninstall --tailscale",
    "service:status": "tsx scripts/service.ts status",
    "service:restart": "tsx scripts/service.ts restart",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329",
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "sqlite-vec": "^0.1.9",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webjihong/hivelane.git"
  },
  "homepage": "https://github.com/webjihong/hivelane"
}
